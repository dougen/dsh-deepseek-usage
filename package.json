{
  "name": "@dougen/dsh-deepseek-usage",
  "version": "0.18.14",
  "description": "A DeepSeek Harness sidebar plugin: the active provider's account balance or subscription usage (DeepSeek, Moonshot/Kimi, GLM, OpenRouter, Kimi Coding, OpenCode, MiniMax, plus Claude Code and Codex OAuth tokens), a provider query-status page, and per-token unit prices for models whose provider has a built-in price snapshot — including DeepSeek's peak/off-peak schedule — in a Chinese/English UI.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dougen/dsh-deepseek-usage.git"
  },
  "homepage": "https://github.com/dougen/dsh-deepseek-usage",
  "bugs": {
    "url": "https://github.com/dougen/dsh-deepseek-usage/issues"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "screenshot.png",
    "screenshot2.png",
    "screenshots.json"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6 || ^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.2.0-rc.1 || ^0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "usage",
    "balance",
    "quota",
    "oauth",
    "tokens",
    "web"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
